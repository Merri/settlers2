---
import BaseHead from '$/components/BaseHead.astro'
import BlogHeader from '$/components/BlogHeader.astro'
import { default as BlogLayout, type Props as Post } from '$/components/BlogPost.astro'

export interface Props {
	content: Post
}

const {
	permalink = new URL(Astro.url.pathname, Astro.site).toString(),
	lang = 'en',
	title,
	seriesTitle,
	description,
	pubDate,
	modDate,
	author,
	heroImage,
	alt,
	disqusIdentifier,
	disqusCanonical,
} = Astro.props.content
---

<html lang={lang}>
	<head>
		<BaseHead
			title={seriesTitle ? `${title} | ${seriesTitle}` : title}
			description={description}
			permalink={permalink}
		/>
		<link rel="stylesheet" href="/blog.css" />
	</head>

	<body>
		<BlogHeader />
		<BlogLayout
			title={title}
			seriesTitle={seriesTitle}
			description={description}
			author={author}
			heroImage={heroImage}
			pubDate={pubDate}
			modDate={modDate}
			alt={alt}
		>
			<slot />
		</BlogLayout>
		<div class="layout">
			<article id="disqus-comments" data-identifier={disqusIdentifier} data-url={disqusCanonical ?? permalink}>
				<header>
					<h2>Comments</h2>
				</header>
				<div id="disqus_thread"></div>
			</article>
		</div>
		<style>
			#disqus_thread {
				background: white;
				background-clip: padding-box;
				border: thin solid rgba(0, 0, 0, 0.4);
				margin-bottom: 8rem;
				min-height: 26rem;
				padding: 1rem;
				position: relative;
			}
		</style>
		<script>
			// eslint-disable-next-line
			var disqus_config = function () {
				const el = document.getElementById('disqus-comments')
				if (!el) return
				const thread = el.dataset
				/* @ts-expect-error Disqus */
				this.page.url = thread.url
				/* @ts-expect-error Disqus */
				this.page.identifier = thread.identifier
			}
			;(function () {
				const s = document.createElement('script')
				s.src = 'https://settlers2.disqus.com/embed.js'
				s.async = true
				s.setAttribute('data-timestamp', '' + Date.now())
				document.head.appendChild(s)
			})()
		</script>
	</body>
</html>
