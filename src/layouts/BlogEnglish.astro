---
import { default as BlogLayout, type Props as Post } from '$/components/BlogPost.astro'

import Layout from './Layout.astro'

export interface Props {
	content: Post
}

const {
	description,
	permalink = new URL(Astro.url.pathname, Astro.site).toString(),
	title,
	seriesTitle,
	pubDate,
	modDate,
	author,
	heroImage,
	alt,
} = Astro.props.content
---

<Layout lang="en" description={description} permalink={permalink} title={title} seriesTitle={seriesTitle}>
	<BlogLayout
		title={title}
		seriesTitle={seriesTitle}
		description={description}
		author={author}
		heroImage={heroImage}
		pubDate={pubDate}
		modDate={modDate}
		alt={alt}
	>
		<slot />
	</BlogLayout>
</Layout>
