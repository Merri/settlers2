{
	"extends": "astro/tsconfigs/strict",
	"compilerOptions": {
		"plugins": [{ "name": "typescript-plugin-css-modules" }],
		"baseUrl": ".",
		"module": "NodeNext",
		"moduleResolution": "nodenext",
		"paths": {
			"$/*": ["src/*"],
			"$layouts/*": ["src/layouts/*"]
		},
		"target": "ES2022",
		"jsx": "react-jsx",
		"jsxImportSource": "preact",
		"skipLibCheck": false
	},
	"include": [".astro/types.d.ts", "src/**/*"],
	"exclude": ["dist", "public"]
}
